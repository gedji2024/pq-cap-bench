    "impacts": [
      {
        "stage": 37,
        "statement": "FEMA 0.2% Annual Chance Flood Level (500 year flood)."
      },
      {
        "stage": 35,
        "statement": "Flood waters begin to reach the Harvey Taylor Bridge."
      },
      {
        "stage": 33.3,
        "statement": "Flood of record from Hurricane Agnes in 1972."
      },
      {
        "stage": 32,
        "statement": "Widespread flooding occurs on both banks. The square and central business district in Harrisburg begin to be affected."
      },
      {
        "stage": 30,
        "statement": "Widespread flooding occurs on both banks."
      },
      {
        "stage": 29,
        "statement": "FEMA 1% Annual Chance Flood Level (100-year flood).  Flood waters begin to reach the Market Street Bridge."
      },
      {
        "stage": 28,
        "statement": "Widespread flooding occurs in the residential sections of Front and Second Streets and in the Shipoke area of Harrisburg.  Flooding reaches Italian Lake Park in Harrisburg."
      },
      {
        "stage": 26,
        "statement": "FEMA 2% Annual Chance Flood Level (50-year flood).  Flood waters begin to reach the Walnut Street Bridge.  Green and Vaughn Streets flood."
      },
      {
        "stage": 24,
        "statement": "The residential section of Front and Second Streets in Harrisburg flood at this level. Cameron Street in Harrisburg floods due to backwater from Paxton Creek."
      },
      {
        "stage": 23,
        "statement": "Evacuations are necessary in the Shipoke area of Harrisburg.  Listen to local emergency officials for specific details.  The water level reaches the corner of Kelker and Front Streets.  Delaware Street, Geiger Street and Maclay Streets may also be impacted."
      },
      {
        "stage": 22.5,
        "statement": "US 22/322 in the vicinity of the Dauphin Narrows is impacted by flood waters."
      },
      {
        "stage": 21,
        "statement": "Homes on both banks are affected by high water. This is the approximate level of Routes 11 and 15, upstream of the Market Street Bridge.  Flood waters begin to reach South Main Street in Marysville."
      },
      {
        "stage": 20.5,
        "statement": "FEMA 10% Annual Chance Flood Level (10-year flood)."
      },
      {
        "stage": 20,
        "statement": "Riverfront Park in Harrisburg begins to flood."
      },
      {
        "stage": 19,
        "statement": "A number of homes in West Fairview, Dauphin, and Harrisburg flood.  Flood waters begin to reach Front Street in East Pennsboro Township in Cumberland County."
      },
      {
        "stage": 17,
        "statement": "Basements of residences and businesses on both banks flood. The parking lot on City Island begins to take on water."
      },
      {
        "stage": 15,
        "statement": "The recreation area of City Island is evacuated. River interests are encouraged to monitor conditions."
      },
      {
        "stage": 13,
        "statement": "The recreation area on City Island is evacuated. River interests are encouraged to monitor conditions."
      },
      {
        "stage": 11,
        "statement": "Recreational use of City Island begins to be curtailed. River interests are encouraged to monitor conditions."
      }
    ]
  },
